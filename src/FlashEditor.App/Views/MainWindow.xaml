<Window x:Class="FlashEditor.App.Views.MainWindow"
        Icon="pack://application:,,,/Assets/FlashEditor.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="clr-namespace:FlashEditor.App.Views.Panels"
        xmlns:editor="clr-namespace:FlashEditor.App.Views.Editor"
        Title="{Binding Title}" Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" AllowDrop="True">


    <Grid>
    <DockPanel>
        <!-- ===== Ribbon (tabs with groups of buttons, like Microsoft Office) ===== -->
        <panels:RibbonBar x:Name="Ribbon" DockPanel.Dock="Top" />

        <!-- ===== Tool options ===== -->
        <panels:OptionsBar DockPanel.Dock="Top" />

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Height="24" TextElement.FontSize="12" TextElement.Foreground="{StaticResource SubtleTextBrush}">
            <DockPanel Margin="10,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="60" TextAlignment="Right" Foreground="{StaticResource TextBrush}" />
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0" Padding="6,0" MinHeight="0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding Image.ImageSizeCommand}"
                        ToolTip="Click to change the image size / resolution">
                    <TextBlock Foreground="{StaticResource SubtleTextBrush}" TextDecorations="Underline">
                        <Run Text="{Binding Document.Width, Mode=OneWay}" /><Run Text=" x " /><Run Text="{Binding Document.Height, Mode=OneWay}" /><Run Text=" px" />
                    </TextBlock>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CursorText}" VerticalAlignment="Center" Margin="0,0,24,0"
                           Foreground="{StaticResource SubtleTextBrush}" MinWidth="110" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
            </DockPanel>
        </Border>

        <!-- ===== Left toolbox ===== -->
        <panels:ToolboxPanel DockPanel.Dock="Left" />

        <!-- ===== Right panels ===== -->
        <Border DockPanel.Dock="Right" Width="290" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
            <Grid x:Name="RightPanels">
                <Grid.RowDefinitions>
                    <!-- Properties and Layers each get a fixed share of the height, so the Layers list never moves when the selected layer shows more or fewer settings -->
                    <RowDefinition Height="3*" MinHeight="150" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="2*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="HistoryRow" Height="Auto" />
                </Grid.RowDefinitions>
                <panels:PropertiesPanel />
                <!-- Drag to give Properties or Layers more room -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource DividerBrush}" Cursor="SizeNS" />
                <panels:LayersPanel Grid.Row="2" />
                <GridSplitter x:Name="HistorySplitter" Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                              Background="{StaticResource DividerBrush}" Visibility="Collapsed" />
                <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource DividerBrush}" VerticalAlignment="Top" />
                <panels:HistoryPanel Grid.Row="4" />
            </Grid>
        </Border>

        <!-- ===== Projects (tabs along the top), the pages of the selected project (strip at the bottom) and the canvas ===== -->
        <DockPanel>
            <!-- Projects -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <panels:ViewAidsBar DockPanel.Dock="Right" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding File.OpenCommand}" ToolTip="Open a picture or project (Ctrl+O)" Margin="0,0,4,0">
                        <Path Style="{StaticResource IconPath}" Data="M3,6 L8,6 L10,8 L17,8 L17,16 L3,16 Z" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding File.NewCommand}" ToolTip="New project (Ctrl+N)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}" />
                    </Button>
                    <Button DockPanel.Dock="Left" Command="{Binding File.ProjectManagerCommand}" Margin="6,4,6,4" Padding="12,3" MinWidth="0" MinHeight="0" FontSize="12"
                            ToolTip="Project Manager: all your projects, and new project (File menu too)" Content="&#x2302; Projects" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ProjectTabs" ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,0,6,0" Height="34" Cursor="Hand" ToolTip="{Binding ToolTip}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.RenameProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <MouseBinding Gesture="MiddleClick" Command="{Binding DataContext.CloseProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                                <Setter Property="TextElement.Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualsConverter}">
                                                                <Binding />
                                                                <Binding Path="DataContext.Document.Project" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource CanvasAreaBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename project" Command="{Binding PlacementTarget.Tag.RenameProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Close project" Command="{Binding PlacementTarget.Tag.CloseProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBox Text="{Binding EditableName, UpdateSourceTrigger=Explicit}" Width="170" Padding="4,1" VerticalAlignment="Center"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                                     IsVisibleChanged="OnTabRenameVisible" KeyDown="OnTabRenameKeyDown" LostKeyboardFocus="OnTabRenameLostFocus" />
                                            <Button Content="&#x2715;" FontSize="10" Width="20" Height="20" Padding="0" Margin="8,0,0,0" MinWidth="0" MinHeight="0"
                                                    Background="Transparent" BorderThickness="0" ToolTip="Close this project (Ctrl+W)"
                                                    Command="{Binding DataContext.CloseProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Pages of the selected project -->
            <Border x:Name="PagesBar" DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Height="128" ClipToBounds="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="92" VerticalAlignment="Center" Margin="10,0,4,0">
                        <TextBlock Text="PAGES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,8">
                            <Run Text="{Binding Document.Project.Pages.Count, Mode=OneWay}" /><Run Text=" in this project" />
                        </TextBlock>
                        <ToggleButton Content="Grid view" IsChecked="{Binding ShowPageGrid}" Padding="8,3" MinWidth="0" MinHeight="0" FontSize="12" HorizontalAlignment="Left"
                                      ToolTip="See all pages as big pictures; drag them to change the order, double-click one to open it" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="PageTabs" ItemsSource="{Binding Document.Project.Pages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                        <Button Width="20" Height="84" Margin="0,8,0,0" VerticalAlignment="Top" Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand" Click="OnInsertPageBefore"
                                                Background="Transparent" BorderThickness="0" ToolTip="Add a new page here"
                                                Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border x:Name="Card" Width="140" Margin="0,8,0,6" Background="Transparent" Cursor="Hand" ToolTip="{Binding TabToolTip}" Focusable="True" FocusVisualStyle="{x:Null}" PreviewMouseLeftButtonDown="OnPageCardDown"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.RenameDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <MouseBinding Gesture="MiddleClick" Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rename" Tag="rename" Click="OnPageMenuClick" />
                                                    <Separator />
                                                    <MenuItem Header="Copy page(s)" Tag="copy" Click="OnPageMenuClick" />
                                                    <MenuItem Header="Paste after this" Tag="paste-after" Click="OnPageMenuClick" />
                                                    <MenuItem Header="Paste before this" Tag="paste-before" Click="OnPageMenuClick" />
                                                    <Separator />
                                                    <MenuItem Header="Add new page after" Tag="add-after" Click="OnPageMenuClick" />
                                                    <MenuItem Header="Add new page before" Tag="add-before" Click="OnPageMenuClick" />
                                                    <MenuItem Header="Duplicate page(s)" Tag="duplicate" Click="OnPageMenuClick" />
                                                    <Separator />
                                                    <MenuItem Header="Move left" Tag="left" Click="OnPageMenuClick" />
                                                    <MenuItem Header="Move right" Tag="right" Click="OnPageMenuClick" />
                                                    <Separator />
                                                    <MenuItem Header="Delete page(s)" Tag="delete" Click="OnPageMenuClick" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <Border Height="84" CornerRadius="4" Background="{StaticResource CanvasAreaBrush}" BorderThickness="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPageSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SelectionAccentBrush}" />
                                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SubtleTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource EqualsConverter}">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.Document" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Image Source="{Binding PageThumbnail}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Button Tag="{Binding ElementName=Card}" Click="OnPageMenuButton" Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                                Width="24" Height="22" Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                                Background="#CC262626" BorderThickness="0" ToolTip="Page menu: rename, duplicate, move, delete">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                    <Setter Property="Opacity" Value="0" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <Grid Margin="2,4,2,0">
                                                    <TextBlock Text="{Binding TabTitle}" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />
                                                    <TextBox Text="{Binding EditableName, UpdateSourceTrigger=Explicit}" Padding="4,1" HorizontalContentAlignment="Center" MinHeight="0"
                                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}"
                                                             IsVisibleChanged="OnTabRenameVisible" KeyDown="OnTabRenameKeyDown" LostKeyboardFocus="OnTabRenameLostFocus" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding File.AddPageCommand}" Width="84" Height="84" Margin="4,8,6,0" VerticalAlignment="Top" Cursor="Hand" Padding="0"
                                    ToolTip="Add a page to this project (Ctrl+Alt+N)" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="Add page" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnPastePages" Width="84" Height="84" Margin="0,8,10,0" VerticalAlignment="Top" Cursor="Hand" Padding="0"
                                    ToolTip="Paste the copied pages here, after the page you are on (Ctrl+V)" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="2"
                                    Visibility="{Binding Pages.HasClipboard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="Paste pages" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- The arrow in the middle folds the page strip away (and brings it back) -->
            <Border x:Name="PagesToggleBar" DockPanel.Dock="Bottom" Height="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Button x:Name="PagesToggle" Click="OnTogglePages" Width="44" Height="16" Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" ToolTip="Hide the pages" />
            </Border>

            <Grid>
                <editor:CanvasView x:Name="CanvasArea" />
                <panels:PageGridView x:Name="PageGrid" Visibility="{Binding ShowPageGrid, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </DockPanel>

    <!-- ===== File drawer (slides in from the left) ===== -->
    <panels:FileDrawer x:Name="FileDrawer" />
    </Grid>
</Window>
