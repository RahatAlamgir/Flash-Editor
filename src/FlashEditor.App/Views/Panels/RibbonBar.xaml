<UserControl x:Class="FlashEditor.App.Views.Panels.RibbonBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Generated layout of the ribbon (tabs along the top, groups of buttons below). Edit freely. -->
    <UserControl.Resources>
        <ContextMenu x:Key="ShapeMenu" />
    </UserControl.Resources>
    <Grid>
        <TabControl x:Name="Tabs" Style="{StaticResource RibbonTabControl}" SelectedIndex="0" PreviewMouseLeftButtonUp="OnTabClicked" MouseDoubleClick="OnTabDoubleClicked">
            <TabItem Header="Edit" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Undo" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A7;" Content="Undo" ToolTip="Undo (Ctrl+Z)" Command="{Binding Edit.UndoCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A6;" Content="Redo" ToolTip="Redo (Ctrl+Y)" Command="{Binding Edit.RedoCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Clipboard" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE77F;" Content="Paste" ToolTip="Paste (Ctrl+V)" Command="{Binding Edit.PasteCommand}" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8C6;" Content="Cut" ToolTip="Cut (Ctrl+X)" Command="{Binding Edit.CutCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8C8;" Content="Copy" ToolTip="Copy (Ctrl+C)" Command="{Binding Edit.CopyCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE74D;" Content="Delete Pixels" ToolTip="Delete Pixels (Delete)" Command="{Binding Edit.DeleteCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Fill" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE790;" Content="Fill Color" ToolTip="Fill with the foreground color" Command="{Binding Edit.FillCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9A3;" Content="Fill (AI)" ToolTip="Select an object, then the AI paints in what would be behind it (Shift+F5)" Command="{Binding Inpaint.FillSelectionCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Layer" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8C8;" Content="Duplicate" ToolTip="Duplicate (Ctrl+D)" Command="{Binding Layers.DuplicateCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE74D;" Content="Delete Layer" Command="{Binding Layers.DeleteCommand}" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8AC;" Content="Rename" Command="{Binding Layers.RenameCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE72E;" Content="Lock / Unlock" ToolTip="Lock / Unlock (Ctrl+L)" Command="{Binding Layers.ToggleLockCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE74B;" Content="Merge Down" ToolTip="Merge Down (Ctrl+E)" Command="{Binding Layers.MergeDownCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Objects" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8A9;" Content="Group" ToolTip="Group (Ctrl+G)" Command="{Binding Layers.GroupCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B4;" Content="Ungroup" ToolTip="Ungroup (Ctrl+Shift+G)" Command="{Binding Layers.UngroupCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE898;" Content="Order ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Bring to Front" Command="{Binding Layers.BringToFrontCommand}" InputGestureText="Ctrl+Shift+]" />
                                            <MenuItem Header="Bring Forward (Move Up)" Command="{Binding Layers.MoveUpCommand}" InputGestureText="Ctrl+]" />
                                            <MenuItem Header="Send Backward (Move Down)" Command="{Binding Layers.MoveDownCommand}" InputGestureText="Ctrl+[" />
                                            <MenuItem Header="Send to Back" Command="{Binding Layers.SendToBackCommand}" InputGestureText="Ctrl+Shift+[" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8E3;" Content="Align ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Align Left" Command="{Binding Align.AlignCommand}" CommandParameter="Left" />
                                            <MenuItem Header="Align Center (horizontally)" Command="{Binding Align.AlignCommand}" CommandParameter="CenterHorizontally" />
                                            <MenuItem Header="Align Right" Command="{Binding Align.AlignCommand}" CommandParameter="Right" />
                                            <Separator />
                                            <MenuItem Header="Align Top" Command="{Binding Align.AlignCommand}" CommandParameter="Top" />
                                            <MenuItem Header="Align Middle (vertically)" Command="{Binding Align.AlignCommand}" CommandParameter="CenterVertically" />
                                            <MenuItem Header="Align Bottom" Command="{Binding Align.AlignCommand}" CommandParameter="Bottom" />
                                            <Separator />
                                            <MenuItem Header="Distribute Horizontally (equal gaps)" Command="{Binding Align.DistributeCommand}" CommandParameter="Horizontally" />
                                            <MenuItem Header="Distribute Vertically (equal gaps)" Command="{Binding Align.DistributeCommand}" CommandParameter="Vertically" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8AB;" Content="Flip Horizontal" Command="{Binding Layers.FlipLayerHorizontalCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8CB;" Content="Flip Vertical" Command="{Binding Layers.FlipLayerVerticalCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Select" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Select" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B3;" Content="Select All" ToolTip="All layers with the Select / Move tool, all pixels with the other tools (Ctrl+A)" Command="{Binding Edit.SelectAllCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8FF;" Content="Deselect" ToolTip="Deselect (Ctrl+Shift+D)" Command="{Binding Edit.DeselectCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B4;" Content="Invert Selection" ToolTip="Invert Selection (Ctrl+Shift+I)" Command="{Binding Edit.InvertSelectionCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Smart" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE794;" Content="Subject (AI)" Command="{Binding Effects.SelectSubjectCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8BF;" Content="Layer Content" Command="{Binding Edit.SelectLayerContentCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Use the selection" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A8;" Content="Crop to Selection" Command="{Binding Image.CropToSelectionCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A8;" Content="Crop Layer" ToolTip="Crop the layer to the selection" Command="{Binding Layers.CropToSelectionCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9A3;" Content="Remove / Fill (AI)" ToolTip="Select an object, then the AI paints in what would be behind it (Shift+F5)" Command="{Binding Inpaint.FillSelectionCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE790;" Content="Fill Color" ToolTip="Fill the selection with the foreground color" Command="{Binding Edit.FillCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Mask from selection" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8BF;" Content="Show Selection Only" ToolTip="The layer shows only the selected area" Command="{Binding Mask.FromSelectionCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8BF;" Content="Hide Selection" ToolTip="Hide the selected area of the layer" Command="{Binding Mask.HideSelectionCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8EB;" Content="Invert Mask" Command="{Binding Mask.InvertCommand}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8BF;" Content="Show All" Command="{Binding Mask.RevealAllCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8BF;" Content="Hide All" Command="{Binding Mask.HideAllCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE74D;" Content="Delete Mask" Command="{Binding Mask.DeleteCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Image" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Size" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE740;" Content="Image Size" ToolTip="Size and resolution (Ctrl+Alt+I)" Command="{Binding Image.ImageSizeCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B2;" Content="Canvas Size" ToolTip="Canvas Size (Ctrl+Alt+C)" Command="{Binding Image.CanvasSizeCommand}" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE9E3;" Content="Upscale 2x (quick)" ToolTip="No AI" Command="{Binding Image.Upscale2xCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE794;" Content="AI Upscale / Clean Up" Command="{Binding Upscale.AiUpscaleCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8AD;" Content="Magic Resize" ToolTip="Turn this design into another size, for example a post into a story" Command="{Binding Image.MagicResizeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Crop" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A8;" Content="Crop to Selection" Command="{Binding Image.CropToSelectionCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9A6;" Content="Perspective Crop" ToolTip="Click the four corners of something photographed at an angle: it is cut out and made flat" Command="{Binding Image.PerspectiveCropCommand}" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE924;" Content="Trim Transparent Edges" Command="{Binding Image.TrimCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE7B3;" Content="Reveal All" ToolTip="Show pixels outside the canvas" Command="{Binding Image.RevealAllCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE7AD;" Content="Straighten" ToolTip="Turn the picture a little and cut off the empty corners" Command="{Binding Image.StraightenCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Rotate and flip" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE72C;" Content="Rotate 90° Clockwise" Command="{Binding Image.Rotate90ClockwiseCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE777;" Content="Rotate 90° Counter-Clockwise" Command="{Binding Image.Rotate90CounterClockwiseCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8EE;" Content="Rotate 180°" Command="{Binding Image.Rotate180Command}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8ED;" Content="Rotate by Angle" Command="{Binding Image.RotateCustomCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8AB;" Content="Flip Horizontal" Command="{Binding Image.FlipHorizontalCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8CB;" Content="Flip Vertical" Command="{Binding Image.FlipVerticalCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Background" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE75C;" Content="Remove BG (AI)" ToolTip="Remove BG (AI) (Ctrl+Alt+B)" Command="{Binding Effects.RemoveBackgroundCommand}" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE790;" Content="Remove by Color" Command="{Binding Effects.RemoveBackgroundByColorCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE9A3;" Content="Remove / Fill Selection (AI)" ToolTip="Select an object, then the AI paints in what would be behind it (Shift+F5)" Command="{Binding Inpaint.FillSelectionCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8A9;" Content="Split Asset Sheet" Command="{Binding Image.SplitSheetCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Layer" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Layers" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE710;" Content="New Layer" ToolTip="New Layer (Ctrl+Shift+N)" Command="{Binding Layers.NewLayerCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8C8;" Content="Duplicate" ToolTip="Duplicate (Ctrl+D)" Command="{Binding Layers.DuplicateCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE74D;" Content="Delete" Command="{Binding Layers.DeleteCommand}" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8AC;" Content="Rename" Command="{Binding Layers.RenameCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE72E;" Content="Lock / Unlock" ToolTip="Lock / Unlock (Ctrl+L)" Command="{Binding Layers.ToggleLockCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Organize" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8A9;" Content="Group" ToolTip="Group (Ctrl+G)" Command="{Binding Layers.GroupCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B4;" Content="Ungroup" ToolTip="Ungroup (Ctrl+Shift+G)" Command="{Binding Layers.UngroupCommand}" />
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE74B;" Content="Merge Down" ToolTip="With several layers selected, Ctrl+E merges all of them (Ctrl+E)" Command="{Binding Layers.MergeDownCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE81E;" Content="Merge Selected" Command="{Binding Layers.MergeSelectedCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8B9;" Content="Flatten Image" Command="{Binding Layers.FlattenCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Arrange" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE898;" Content="Order ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Bring to Front" Command="{Binding Layers.BringToFrontCommand}" InputGestureText="Ctrl+Shift+]" />
                                            <MenuItem Header="Bring Forward (Move Up)" Command="{Binding Layers.MoveUpCommand}" InputGestureText="Ctrl+]" />
                                            <MenuItem Header="Send Backward (Move Down)" Command="{Binding Layers.MoveDownCommand}" InputGestureText="Ctrl+[" />
                                            <MenuItem Header="Send to Back" Command="{Binding Layers.SendToBackCommand}" InputGestureText="Ctrl+Shift+[" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8E3;" Content="Align ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Align Left" Command="{Binding Align.AlignCommand}" CommandParameter="Left" />
                                            <MenuItem Header="Align Center (horizontally)" Command="{Binding Align.AlignCommand}" CommandParameter="CenterHorizontally" />
                                            <MenuItem Header="Align Right" Command="{Binding Align.AlignCommand}" CommandParameter="Right" />
                                            <Separator />
                                            <MenuItem Header="Align Top" Command="{Binding Align.AlignCommand}" CommandParameter="Top" />
                                            <MenuItem Header="Align Middle (vertically)" Command="{Binding Align.AlignCommand}" CommandParameter="CenterVertically" />
                                            <MenuItem Header="Align Bottom" Command="{Binding Align.AlignCommand}" CommandParameter="Bottom" />
                                            <Separator />
                                            <MenuItem Header="Distribute Horizontally (equal gaps)" Command="{Binding Align.DistributeCommand}" CommandParameter="Horizontally" />
                                            <MenuItem Header="Distribute Vertically (equal gaps)" Command="{Binding Align.DistributeCommand}" CommandParameter="Vertically" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8AB;" Content="Flip Layer Horizontal" Command="{Binding Layers.FlipLayerHorizontalCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8CB;" Content="Flip Layer Vertical" Command="{Binding Layers.FlipLayerVerticalCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8B9;" Content="Convert to Pixels" Command="{Binding Layers.ConvertToPixelsCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Mask" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7C4;" Content="Clip Below" ToolTip="The layer shows only inside the shape of the layer under it (a picture inside a shape or text)" Command="{Binding Mask.ClipToBelowCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8BF;" Content="Layer Mask ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add Mask: Show All" Command="{Binding Mask.RevealAllCommand}" ToolTip="A mask that shows everything: paint black on it (Mask Brush, K) to hide parts" />
                                            <MenuItem Header="Add Mask: Hide All" Command="{Binding Mask.HideAllCommand}" ToolTip="A mask that hides everything: paint white on it to show parts" />
                                            <MenuItem Header="Add Mask: Show Selection Only" Command="{Binding Mask.FromSelectionCommand}" ToolTip="The layer shows only the selected area" />
                                            <MenuItem Header="Add Mask: Hide Selection" Command="{Binding Mask.HideSelectionCommand}" ToolTip="Hide the selected area of the layer" />
                                            <Separator />
                                            <MenuItem Header="Invert Mask" Command="{Binding Mask.InvertCommand}" />
                                            <MenuItem Header="Switch Mask On / Off" Command="{Binding Mask.ToggleCommand}" ToolTip="See the layer without its mask, and back" />
                                            <MenuItem Header="Apply Mask to Pixels" Command="{Binding Mask.ApplyCommand}" ToolTip="Make the hidden parts transparent pixels for good" />
                                            <MenuItem Header="Delete Mask" Command="{Binding Mask.DeleteCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Special layers" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE793;" Content="Adjustment ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add Levels Layer" Command="{Binding Layers.AddLevelsLayerCommand}" ToolTip="Black point, white point and middle tones, as a layer you can change later" />
                                            <MenuItem Header="Add Curves Layer" Command="{Binding Layers.AddCurvesLayerCommand}" ToolTip="Bend the tone curve of all colors or of red, green or blue, as a layer you can change later" />
                                            <MenuItem Header="Add Adjustment Layer" Command="{Binding Layers.AddAdjustmentLayerCommand}" ToolTip="Brightness, contrast, saturation and hue for everything below it, without changing any picture" />
                                            <MenuItem Header="Add Gradient Background" Command="{Binding Layers.AddGradientBackgroundCommand}" ToolTip="A gradient behind everything" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A8;" Content="Crop Layer ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Crop This Object..." Command="{Binding Layers.CropObjectCommand}" />
                                            <MenuItem Header="Crop Layer to Selection" Command="{Binding Layers.CropToSelectionCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE72E;" Content="Lock All Selected" Command="{Binding Layers.LockSelectedCommand}" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE785;" Content="Unlock All Selected" Command="{Binding Layers.UnlockSelectedCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Insert" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="New layer" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE710;" Content="New Layer" ToolTip="New Layer (Ctrl+Shift+N)" Command="{Binding Layers.NewLayerCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8F4;" Content="New Page" ToolTip="A new empty page after this one (Ctrl+Alt+N)" Command="{Binding File.AddPageCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE790;" Content="Gradient Background" ToolTip="A gradient behind everything" Command="{Binding Layers.AddGradientBackgroundCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Image" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE91B;" Content="Place Image" ToolTip="Add a picture file as a new layer" Command="{Binding File.PlaceCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B2;" Content="Frame ▾" ToolTip="A frame that a picture can be put into" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rectangle" Command="{Binding Insert.AddFrameCommand}" CommandParameter="Rectangle" />
                                            <MenuItem Header="Rounded" Command="{Binding Insert.AddFrameCommand}" CommandParameter="Rounded" />
                                            <MenuItem Header="Circle" Command="{Binding Insert.AddFrameCommand}" CommandParameter="Circle" />
                                            <MenuItem Header="Heart" Command="{Binding Insert.AddFrameCommand}" CommandParameter="Heart" />
                                            <MenuItem Header="Star" Command="{Binding Insert.AddFrameCommand}" CommandParameter="Star" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE80A;" Content="Photo Grid" ToolTip="Add frames in a collage layout" Command="{Binding Insert.PhotoGridCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8A8;" Content="Fill Frames" ToolTip="Select one or more frames (shapes), then choose the pictures to put in them" Command="{Binding Insert.FillFramesCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Shape" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <WrapPanel Width="210" VerticalAlignment="Center" Margin="2,0" Loaded="OnQuickShapesLoaded" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE739;" Content="Shapes ▾" ToolTip="All shapes: rectangle, circle, star, arrow, line and more" Click="OnDropDown" ContextMenu="{StaticResource ShapeMenu}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Chart" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9D2;" Content="Chart ▾" ToolTip="A chart you can edit with your own numbers" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Columns" Command="{Binding Insert.AddChartCommand}" CommandParameter="Columns">
                                                <MenuItem.Icon><Path Data="F0 M2,14 L2,8 L5,8 L5,14 Z M6.5,14 L6.5,2 L9.5,2 L9.5,14 Z M11,14 L11,5 L14,5 L14,14 Z" Fill="{StaticResource IconBrush}" Width="15" Height="15" Stretch="Uniform" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Bars" Command="{Binding Insert.AddChartCommand}" CommandParameter="Bars">
                                                <MenuItem.Icon><Path Data="F0 M2,2 L10,2 L10,5 L2,5 Z M2,6.5 L14,6.5 L14,9.5 L2,9.5 Z M2,11 L7,11 L7,14 L2,14 Z" Fill="{StaticResource IconBrush}" Width="15" Height="15" Stretch="Uniform" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Line" Command="{Binding Insert.AddChartCommand}" CommandParameter="Line">
                                                <MenuItem.Icon><Path Data="F0 M1.5,12 L5.5,6.5 L8.5,9.5 L14.5,2.5" Stroke="{StaticResource IconBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Pie" Command="{Binding Insert.AddChartCommand}" CommandParameter="Pie">
                                                <MenuItem.Icon><Path Data="F0 M8,8.5 L8,1.5 A7,7 0 1 1 1.3,10.6 Z M6.8,7.3 L1.6,7.3 A6.5,6.5 0 0 1 6.8,1.7 Z" Fill="{StaticResource IconBrush}" Width="15" Height="15" Stretch="Uniform" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Donut" Command="{Binding Insert.AddChartCommand}" CommandParameter="Donut">
                                                <MenuItem.Icon><Path Data="F0 M8,1 A7,7 0 1 0 8.01,1 Z M8,4.8 A3.2,3.2 0 1 1 7.99,4.8 Z" Fill="{StaticResource IconBrush}" Width="15" Height="15" Stretch="Uniform" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Codes" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8A9;" Content="QR Code" ToolTip="A QR code that stays editable (web address, phone number, any text)" Command="{Binding Insert.AddQrCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8EC;" Content="Barcode ▾" Click="OnDropDown">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Code 128 (any text)..." Command="{Binding Insert.AddBarcodeCommand}" CommandParameter="Code128" />
                                            <MenuItem Header="EAN-13 (shop products)..." Command="{Binding Insert.AddBarcodeCommand}" CommandParameter="Ean13" />
                                            <MenuItem Header="UPC-A (US shop products)..." Command="{Binding Insert.AddBarcodeCommand}" CommandParameter="UpcA" />
                                            <MenuItem Header="EAN-8 (small products)..." Command="{Binding Insert.AddBarcodeCommand}" CommandParameter="Ean8" />
                                            <MenuItem Header="Code 39 (capitals and digits)..." Command="{Binding Insert.AddBarcodeCommand}" CommandParameter="Code39" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Adjust" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Tone" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9A9;" Content="Auto Levels" Command="{Binding Effects.AutoLevelsCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE793;" Content="Brightness / Contrast" Command="{Binding Effects.BrightnessContrastCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE706;" Content="Exposure / Gamma" Command="{Binding Effects.ExposureCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Color" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE790;" Content="Recolor" ToolTip="Change colors with a color graph and keep the shading (Ctrl+Shift+R)" Command="{Binding Effects.RecolorCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A1;" Content="Hue / Saturation" Command="{Binding Effects.HueSaturationCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE734;" Content="Vibrance" Command="{Binding Effects.VibranceCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9CA;" Content="Temperature / Tint" Command="{Binding Effects.TemperatureCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Adjustment layers" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9E9;" Content="Levels Layer" ToolTip="Black point, white point and middle tones, as a layer you can change later" Command="{Binding Layers.AddLevelsLayerCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9D2;" Content="Curves Layer" ToolTip="Bend the tone curve, as a layer you can change later" Command="{Binding Layers.AddCurvesLayerCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE793;" Content="Adjustment Layer" ToolTip="Brightness, contrast, saturation and hue for everything below it, without changing any picture" Command="{Binding Layers.AddAdjustmentLayerCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Looks" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7A1;" Content="Grayscale" Command="{Binding Effects.GrayscaleCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8EB;" Content="Invert Colors" Command="{Binding Effects.InvertCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE81D;" Content="Sepia" Command="{Binding Effects.SepiaCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8B7;" Content="Posterize" Command="{Binding Effects.PosterizeCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE73D;" Content="Threshold" ToolTip="Black and white" Command="{Binding Effects.ThresholdCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Filter" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Clean up" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE794;" Content="AI Upscale" ToolTip="AI clean up and upscale" Command="{Binding Upscale.AiUpscaleCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9A3;" Content="Enhance" ToolTip="Clean up blur, no AI" Command="{Binding Effects.EnhanceCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9E3;" Content="Upscale 2x" ToolTip="Quick, no AI" Command="{Binding Image.Upscale2xCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Blur and sharpen" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7B3;" Content="Blur" Command="{Binding Effects.BlurCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE768;" Content="Motion Blur" Command="{Binding Effects.MotionBlurCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7C6;" Content="Sharpen" Command="{Binding Effects.SharpenCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Noise" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8FB;" Content="Reduce Noise" Command="{Binding Effects.ReduceNoiseCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE75F;" Content="Add Noise" Command="{Binding Effects.NoiseCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Stylize" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE80A;" Content="Pixelate" Command="{Binding Effects.PixelateCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE81D;" Content="Vignette" Command="{Binding Effects.VignetteCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE7C8;" Content="Emboss" Command="{Binding Effects.EmbossCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE70F;" Content="Find Edges" Command="{Binding Effects.FindEdgesCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="View" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Zoom" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8A3;" Content="Zoom In" ToolTip="Zoom In (Ctrl++)" Command="{Binding View.ZoomInCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE71F;" Content="Zoom Out" ToolTip="Zoom Out (Ctrl+-)" Command="{Binding View.ZoomOutCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE740;" Content="Fit on Screen" ToolTip="Fit on Screen (Ctrl+0)" Command="{Binding View.FitCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE9A6;" Content="100%" ToolTip="Actual size (Ctrl+1)" Command="{Binding View.ActualSizeCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Show" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <ToggleButton Style="{StaticResource RibbonSmallToggle}" Tag="&#xE70B;" Content="Rulers" IsChecked="{Binding Aids.ShowRulers}" ToolTip="Ctrl+R" />
                                    <ToggleButton Style="{StaticResource RibbonSmallToggle}" Tag="&#xE80A;" Content="Grid" IsChecked="{Binding Aids.ShowGrid}" ToolTip="Ctrl+'" />
                                    <ToggleButton Style="{StaticResource RibbonSmallToggle}" Tag="&#xE8B2;" Content="Guides" IsChecked="{Binding Aids.ShowGuides}" ToolTip="Ctrl+;" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="2,0">
                                    <ToggleButton Style="{StaticResource RibbonSmallToggle}" Tag="&#xE718;" Content="Snapping" IsChecked="{Binding Aids.SnapEnabled}" ToolTip="Ctrl+Shift+;" />
                                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE894;" Content="Clear Guides" Command="{Binding View.ClearGuidesCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Pictures" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE72A;" Content="Next Picture" ToolTip="Next Picture (Ctrl+Tab)" Command="{Binding NextDocumentCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE80F;" Content="Projects" ToolTip="All your projects, and create a new one" Command="{Binding File.ProjectManagerCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE711;" Content="Close Page" Command="{Binding CloseDocumentCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Help" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE768;" Content="Quick Tour" Command="{Binding View.TourCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE765;" Content="Shortcuts" ToolTip="Keyboard shortcuts (F1)" Command="{Binding View.ShortcutsCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE946;" Content="About" ToolTip="About Flash Editor" Command="{Binding View.AboutCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Settings" Style="{StaticResource RibbonTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <HeaderedContentControl Header="Settings" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE81C;" Content="Undo Steps" ToolTip="How many steps Undo can go back in a project (default 30, at most 60)" Command="{Binding View.SettingsCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE790;" Content="Brand Kit" ToolTip="Your brand colors and fonts, kept for every project" Command="{Binding View.BrandKitCommand}" />
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8D4;" Content="AI Models" ToolTip="See which AI models are on this PC, how much space they use, and download or delete them" Command="{Binding Effects.ShowAiModelsCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Keys" Style="{StaticResource RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLarge}" Tag="&#xE765;" Content="Shortcuts" ToolTip="See and change the keyboard shortcuts" Command="{Binding View.ShortcutsCommand}" />
                            </StackPanel>
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Button x:Name="FileButton" Style="{StaticResource RibbonFileButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,3,0,0" Click="OnFileClicked" ToolTip="Open, save, export and more">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource RibbonIconFont}" FontSize="13" Text="&#xE700;" VerticalAlignment="Center" Margin="0,1,7,0" /><TextBlock Text="File" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button x:Name="CollapseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,8,0" Width="24" Height="22" Style="{StaticResource IconButton}"
                Click="OnCollapseClicked" ToolTip="Hide or show the ribbon (double-click a tab does the same)" Padding="0">
            <TextBlock x:Name="CollapseGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Text="&#xE70E;" />
        </Button>
    </Grid>
</UserControl>
