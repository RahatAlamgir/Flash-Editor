<UserControl x:Class="FlashEditor.App.Views.Panels.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opt="clr-namespace:FlashEditor.App.Tools.Options"
             xmlns:ctl="clr-namespace:FlashEditor.App.Views.Controls">
    <!-- Settings of the selected shape / text / image. Every change is undoable. -->
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="62" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Properties.Title}" Foreground="{StaticResource SubtleTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="PROPERTIES" Style="{StaticResource PanelHeader}" />
        </DockPanel>

        <Grid>
            <!-- A layer of plain pixels: no shadow / size / rotation settings until it is made into a picture object -->
            <StackPanel Margin="10,2,10,10" DataContext="{Binding Properties}"
                        Visibility="{Binding IsPixelLayer, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                           Text="This layer is made of plain pixels (painted, or turned into pixels), so it has no shadow, size or rotation settings." />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,6,0,0"
                           Text="Make it editable to get them: it becomes a picture you can resize, rotate and give a shadow." />
                <Button Content="Make editable" Command="{Binding MakeEditableCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5"
                        ToolTip="Turn this layer into a picture object (resize, rotate, shadow). Ctrl+Z undoes it." />
            </StackPanel>

            <!-- Nothing editable selected (no layer, or a layer that is not an object) -->
            <TextBlock Margin="10,2,10,10" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                       Text="Click a shape, text or image with the Select / Move tool (V) to change its color, border, size, rotation or font here."
                       Visibility="{Binding Properties.ShowHint, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,8" MaxHeight="440"
                          Visibility="{Binding Properties.HasObject, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Properties}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="This layer is locked." Foreground="#FFFFB020" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Unlock" Command="{Binding UnlockCommand}" Padding="10,3" ToolTip="Unlock this layer so it can be changed (Ctrl+L)" />
                    </StackPanel>
                    <!-- Inside a group: which part is being edited, and how to get out -->
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="8,6" Margin="0,2,0,4"
                            Visibility="{Binding IsPart, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PartInfo}" TextWrapping="Wrap" FontSize="12" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Back to group (Esc)" Command="{Binding LeavePartCommand}" Margin="0,0,4,0" />
                                <Button Content="Delete part" Command="{Binding DeletePartCommand}"
                                        ToolTip="Remove this part from the group (Ctrl+Z brings it back)" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel IsEnabled="{Binding CanEdit}">
                    <!-- Position, size, rotation -->
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="X" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Number}" Text="{Binding X, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="Y" Style="{StaticResource Label}" Margin="12,0,6,0" />
                        <TextBox Style="{StaticResource Number}" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="W" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Number}" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="H" Style="{StaticResource Label}" Margin="12,0,6,0" />
                        <TextBox Style="{StaticResource Number}" Text="{Binding Height, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsLine, Converter={StaticResource InverseBool}}" />
                        <CheckBox IsChecked="{Binding KeepRatio}" Content="Lock" MinWidth="0" Margin="10,0,0,0" VerticalAlignment="Center"
                                  ToolTip="Keep the width/height ratio" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Text="Rotate" Style="{StaticResource Label}" />
                        <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding Rotation}" SliderWidth="96" BoxWidth="58" Unit="°" />
                    </StackPanel>

                    <!-- Shape -->
                    <StackPanel Visibility="{Binding IsShape, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Shape" Style="{StaticResource Section}" />
                        <!-- The kind of shape is chosen when it is drawn (Shapes tool); here it is only shown -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                            <Path Data="{Binding ShapeKind, Converter={StaticResource ShapeIcon}}" Stroke="{StaticResource IconBrush}" Fill="#40FFFFFF" StrokeThickness="1.3"
                                  Stretch="Uniform" Width="16" Height="16" StrokeLineJoin="Round" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ShapeKind, Converter={StaticResource ShapeName}}" VerticalAlignment="Center" />
                            <TextBlock Text=" (custom outline)" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding HasCustomOutline, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Reshape: drag the corner points of a straight-sided shape (a square becomes a trapezium...) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding CanReshape, Converter={StaticResource BoolToVisibility}}">
                            <ToggleButton Content="Reshape corners" IsChecked="{Binding IsReshaping, Mode=OneWay}" Command="{Binding ToggleReshapeCommand}"
                                          Padding="10,4" ToolTip="Drag the round corner points of the shape on the canvas to change its form. Esc or a second click finishes." />
                            <Button Content="Reset" Command="{Binding ResetShapeCommand}" Padding="10,4" Margin="6,0,0,0"
                                    Visibility="{Binding HasCustomOutline, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Back to the normal outline of this shape" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding CanFill, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Fill" IsChecked="{Binding FillEnabled}" Width="70" MinWidth="0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource ColorSwatchButton}" Background="{Binding FillBrush}" Command="{Binding PickFillCommand}" ToolTip="Fill color" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <CheckBox Content="{Binding IsLine, Converter={StaticResource LineOrBorder}}" IsChecked="{Binding StrokeEnabled}" Width="70" MinWidth="0" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsLine, Converter={StaticResource InverseBool}}" />
                            <Button Style="{StaticResource ColorSwatchButton}" Background="{Binding StrokeBrush}" Command="{Binding PickStrokeCommand}" ToolTip="Border / line color" />
                            <ctl:NumberSlider Minimum="0" Maximum="200" Value="{Binding StrokeWidth}" SliderWidth="44" BoxWidth="58" Unit="px" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasCorners, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Corners" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="0" Maximum="500" Value="{Binding CornerRadius}" SliderWidth="110" BoxWidth="58" Unit="px" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasInner, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding InnerLabel}" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="0" Maximum="95" Value="{Binding InnerPercent}" SliderWidth="110" BoxWidth="58" Unit="%" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasSweep, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Angle" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="10" Maximum="360" Value="{Binding Sweep}" SliderWidth="110" BoxWidth="58" Unit="°" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasPoints, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Points" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="3" Maximum="24" Value="{Binding Points}" SliderWidth="110" BoxWidth="58" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Text -->
                    <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Text" Style="{StaticResource Section}" />
                        <TextBox Text="{Binding TextContent, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="44" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,2,0,4"
                                 ToolTip="Type, then click elsewhere to apply" />
                        <ComboBox ItemsSource="{Binding Source={x:Static opt:TextToolOptions.InstalledFonts}}" SelectedItem="{Binding FontFamily}"
                                  Margin="0,2,0,4">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source}" FontFamily="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Size" Style="{StaticResource Label}" />
                            <ctl:NumberSlider Minimum="4" Maximum="1000" Value="{Binding FontSize}" SliderWidth="76" BoxWidth="58" Unit="px" />
                            <Button Style="{StaticResource ColorSwatchButton}" Background="{Binding TextBrush}" Command="{Binding PickTextColorCommand}" ToolTip="Text color" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <ToggleButton Content="B" FontWeight="Bold" Width="36" Padding="0" IsChecked="{Binding Bold}" ToolTip="Bold" />
                            <ToggleButton Content="I" FontStyle="Italic" Width="36" Padding="0" Margin="4,0,0,0" IsChecked="{Binding Italic}" ToolTip="Italic" />
                            <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Align}" Width="90" Margin="10,0,0,0" ToolTip="Alignment of the lines" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Image -->
                    <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Image" Style="{StaticResource Section}" />
                        <Button Content="Original size" Command="{Binding OriginalSizeCommand}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Shadow (shapes, text, images and groups) -->
                    <TextBlock Text="Shadow" Style="{StaticResource Section}" />
                    <StackPanel Style="{StaticResource Row}">
                        <CheckBox Content="Shadow" IsChecked="{Binding ShadowEnabled}" Width="84" MinWidth="0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource ColorSwatchButton}" Background="{Binding ShadowBrush}" Command="{Binding PickShadowColorCommand}"
                                ToolTip="Shadow color" Visibility="{Binding ShadowEnabled, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <!-- Quick looks: one click adds the shadow and sets everything -->
                    <TextBlock Text="Presets" Style="{StaticResource Label}" Margin="0,4,0,2" />
                    <ItemsControl ItemsSource="{Binding ShadowPresetItems}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A picture of the shadow on a sample object, with its name underneath -->
                                <Button Width="60" MinWidth="0" Margin="0,0,5,5" Padding="2" ToolTip="{Binding Description}"
                                        Command="{Binding DataContext.ApplyShadowPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Preset}">
                                    <StackPanel>
                                        <Border CornerRadius="3" ClipToBounds="True" HorizontalAlignment="Center">
                                            <Image Source="{Binding Preview}" Width="52" Height="52" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding ShadowEnabled, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Opacity" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding ShadowOpacity}" SliderWidth="110" BoxWidth="58" Unit="%" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Blur" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding ShadowBlur}" SliderWidth="110" BoxWidth="58" Unit="px" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Distance" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="0" Maximum="200" Value="{Binding ShadowDistance}" SliderWidth="110" BoxWidth="58" Unit="px" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Angle" Style="{StaticResource Label}" Width="58" />
                            <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding ShadowAngle}" SliderWidth="110" BoxWidth="58" Unit="°" />
                        </StackPanel>
                    </StackPanel>

                    </StackPanel>
                    <!-- Group -->
                    <StackPanel Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Group" Style="{StaticResource Section}" />
                        <Button Content="Ungroup (Ctrl+Shift+G)" Command="{Binding DataContext.Layers.UngroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                HorizontalAlignment="Left" Margin="0,2,0,0" />
                    </StackPanel>
                    <!-- Actions -->
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Flip H" Command="{Binding FlipHorizontalCommand}" Margin="0,0,4,4" ToolTip="Mirror left-right" />
                        <Button Content="Flip V" Command="{Binding FlipVerticalCommand}" Margin="0,0,4,4" ToolTip="Mirror top-bottom" />
                        <Button Content="To pixels" Command="{Binding ConvertToPixelsCommand}" Margin="0,0,4,4"
                                ToolTip="Turns this object into plain pixels so you can paint on it. Afterwards you can no longer change its text, shadow or shape settings. (Use Make editable on a pixel layer to turn it back into a picture.) Ctrl+Z undoes it." />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
