<UserControl x:Class="FlashEditor.App.Views.Panels.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:opt="clr-namespace:FlashEditor.App.Tools.Options"
             xmlns:vm="clr-namespace:FlashEditor.App.ViewModels"
             xmlns:ctl="clr-namespace:FlashEditor.App.Views.Controls">
    <!-- Settings of the selected shape / text / image, as an inspector: a title bar and sections that open and close. Every change is undoable. -->
    <UserControl.Resources>
        <!-- Everything inside the inspector is compact (smaller buttons, boxes and drop-downs) -->
        <Style TargetType="Button" BasedOn="{StaticResource CompactButton}" />
        <Style TargetType="ToggleButton" BasedOn="{StaticResource CompactToggle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource CompactCombo}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource CompactCheck}" />
        <Style TargetType="Expander" BasedOn="{StaticResource Foldout}" />
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource InspectorLabel}" />
        <Style x:Key="ShortLabel" TargetType="TextBlock" BasedOn="{StaticResource InspectorLabel}">
            <Setter Property="Width" Value="16" />
        </Style>
        <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource CompactField}" />
        <Style x:Key="Row" TargetType="StackPanel" BasedOn="{StaticResource InspectorRow}" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Properties.Title}" Style="{StaticResource PanelTitleInfo}" />
                <TextBlock Text="PROPERTIES" Style="{StaticResource PanelTitle}" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- An adjustment layer (brightness / contrast, Levels, Curves): its settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Properties.IsAdjustmentLayer, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="10,8,10,10">
            <TextBlock Text="This layer changes the colors of all layers below it. Nothing in the pictures is changed, so you can tune it or delete it at any time." FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Levels -->
            <StackPanel Visibility="{Binding Document.ActiveLayer.AdjustIsLevels, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Black point" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" ToolTip="This brightness and everything darker becomes black" />
                    <ctl:NumberSlider Grid.Column="1" Minimum="0" Maximum="254" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.LevelsBlack}" /></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Middle tones" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" ToolTip="Above 1 lighter, below 1 darker" />
                    <ctl:NumberSlider Grid.Column="1" Minimum="0.1" Maximum="5" Step="0.05" Decimals="2" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.LevelsGamma}" /></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="White point" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" ToolTip="This brightness and everything lighter becomes white" />
                    <ctl:NumberSlider Grid.Column="1" Minimum="1" Maximum="255" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.LevelsWhite}" /></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Output dark" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" ToolTip="Black becomes this brightness (lifts the shadows)" />
                    <ctl:NumberSlider Grid.Column="1" Minimum="0" Maximum="254" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.OutputBlack}" /></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Output light" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" ToolTip="White becomes this brightness (dims the highlights)" />
                    <ctl:NumberSlider Grid.Column="1" Minimum="1" Maximum="255" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.OutputWhite}" /></Grid>
            </StackPanel>

            <!-- Curves -->
            <StackPanel Visibility="{Binding Document.ActiveLayer.AdjustIsCurves, Converter={StaticResource BoolToVisibility}}">
                <ComboBox Style="{StaticResource CompactCombo}" ItemsSource="{Binding Document.ActiveLayer.CurveChannels}" SelectedIndex="{Binding Document.ActiveLayer.CurveChannel}"
                          ToolTip="Which colors the curve changes" Margin="0,0,0,6" />
                <ctl:CurveEditor Layer="{Binding Document.ActiveLayer}" HorizontalAlignment="Left" />
                <TextBlock Text="Click the curve to add a point, drag to bend it. Double-click a point to remove it." FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Brightness, contrast, color -->
            <StackPanel Visibility="{Binding Document.ActiveLayer.AdjustIsBasic, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Brightness" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-100" Maximum="100" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.AdjustBrightness}" /></Grid>
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Contrast" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-100" Maximum="100" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.AdjustContrast}" /></Grid>
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Saturation" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-100" Maximum="100" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.AdjustSaturation}" /></Grid>
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Hue" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-180" Maximum="180" SliderWidth="96" BoxWidth="58" Unit="&#xB0;" Value="{Binding Document.ActiveLayer.AdjustHue}" /></Grid>
            </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Nothing editable selected (no layer, or a layer that is not an object) -->
            <TextBlock Margin="10,8,10,10" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                       Text="Click a shape, text or image with the Select / Move tool (V) to change its color, border, size, rotation or font here."
                       Visibility="{Binding Properties.ShowHint, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Properties.CanInspect, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Properties}">
                    <StackPanel Orientation="Horizontal" Margin="10,8,10,0"
                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="This layer is locked." Foreground="#FFFFB020" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Unlock" Command="{Binding UnlockCommand}" ToolTip="Unlock this layer so it can be changed (Ctrl+L)" />
                    </StackPanel>
                    <!-- Inside a group: which part is being edited, and how to get out -->
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="8,6" Margin="10,8,10,0"
                            Visibility="{Binding IsPart, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding PartInfo}" TextWrapping="Wrap" FontSize="12" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Back to group (Esc)" Command="{Binding LeavePartCommand}" Margin="0,0,4,0" />
                                <Button Content="Delete part" Command="{Binding DeletePartCommand}"
                                        ToolTip="Remove this part from the group (Ctrl+Z brings it back)" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="10,8,10,0" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5"
                               Visibility="{Binding IsPixelLayer, Converter={StaticResource BoolToVisibility}}"
                               Text="This layer is plain pixels. Changing its size, rotation or looks here turns it into a movable picture automatically (Ctrl+Z undoes it)." />
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <!-- Position, size, rotation -->
                        <Expander Header="Transform" IsExpanded="True">
                            <StackPanel>
                                <Grid IsEnabled="{Binding IsSingle}" ToolTip="Position and size can only be set for one layer at a time (use Align to line several layers up)">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Position" Style="{StaticResource Label}" Width="58" VerticalAlignment="Center" />
                                    <DockPanel Grid.Row="0" Grid.Column="1" >
                                        <TextBlock DockPanel.Dock="Left" Text="X" Style="{StaticResource ShortLabel}" VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource Number}" Text="{Binding X, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                    <DockPanel Grid.Row="0" Grid.Column="3" >
                                        <TextBlock DockPanel.Dock="Left" Text="Y" Style="{StaticResource ShortLabel}" VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource Number}" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Label}" Width="58" VerticalAlignment="Center" Margin="0,6,0,0" />
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="W" Style="{StaticResource ShortLabel}" VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource Number}" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" />
                                    </DockPanel>
                                    <DockPanel Grid.Row="1" Grid.Column="3" Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Left" Text="H" Style="{StaticResource ShortLabel}" VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource Number}" Text="{Binding Height, UpdateSourceTrigger=LostFocus}"
                                                 IsEnabled="{Binding IsLine, Converter={StaticResource InverseBool}}" />
                                    </DockPanel>
                                    <ToggleButton Grid.Row="1" Grid.Column="4" IsChecked="{Binding KeepRatio}" Margin="6,6,0,0" Padding="5,3" VerticalAlignment="Stretch"
                                                  ToolTip="Keep proportions: when on, changing the width also changes the height (and the other way round)">
                                        <Viewbox Width="14" Height="14"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Link}" /></Viewbox>
                                    </ToggleButton>
                                    <TextBlock Grid.Row="2" Text="Rotate" Style="{StaticResource Label}" Width="58" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                                        <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding Rotation}" SliderWidth="84" BoxWidth="50" Unit="°" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Turn" Style="{StaticResource Label}" Width="58" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal">
                                        <Button Command="{Binding RotateLeftCommand}" ToolTip="Rotate 90° left" Padding="10,4" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateLeft}" /></Viewbox><TextBlock Text="90° left" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Command="{Binding RotateRightCommand}" ToolTip="Rotate 90° right" Padding="10,4">
                                            <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateRight}" /></Viewbox><TextBlock Text="90° right" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Flip" Style="{StaticResource Label}" Width="58" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding FlipHorizontalCommand}" ToolTip="Mirror left-right" Padding="10,4" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FlipH}" /></Viewbox><TextBlock Text="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                        <Button Command="{Binding FlipVerticalCommand}" ToolTip="Mirror top-bottom" Padding="10,4">
                                            <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FlipV}" /></Viewbox><TextBlock Text="Vertical" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0" Visibility="{Binding CanReshape, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reshape" Style="{StaticResource Label}" Width="58" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ToggleButton Content="Reshape corners" IsChecked="{Binding IsReshaping, Mode=OneWay}" Command="{Binding ToggleReshapeCommand}" Padding="10,4"
                                                      ToolTip="Drag the round corner points on the canvas to change the form of the object (also outward). Esc or a second click finishes." />
                                        <Button Content="Reset" Command="{Binding ResetShapeCommand}" Margin="6,0,0,0" Padding="10,4"
                                                Visibility="{Binding HasCustomOutline, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Back to the normal form of this object" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0" Visibility="{Binding CanSaveLook, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Look" Style="{StaticResource Label}" Width="58" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Save this look..." Command="{Binding SaveStyleCommand}" HorizontalAlignment="Left" Padding="10,4"
                                            ToolTip="Saves the shadow, 3D, gradient and colors of this object under a name, to use on other objects (they appear below to use again)" />
                                </Grid>
                                <TextBlock Text="Saved looks: click one to put it on the selected object (right-click: delete it)" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,8,0,0" Visibility="{Binding HasSavedStyles, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding SavedStyles}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" Margin="0,0,5,5" ToolTip="Put this look on the selected object (right-click: delete it)"
                                                    Command="{Binding DataContext.ApplyStyleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Delete this saved look"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteStyleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Tag>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </Button.Tag>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- Align: snap to a spot of the canvas (the squares), or along one direction (the rows) -->
                        <Expander Header="Align" IsExpanded="True">
                            <StackPanel>
                                <TextBlock Text="Line the selected layer up with the canvas (several layers line up with each other)" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel>
                                        <TextBlock Text="Position" Style="{StaticResource Label}" Width="Auto" Margin="0,0,0,4" />
                                        <UniformGrid Columns="3" Rows="3" Width="111">
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="Left,Top" ToolTip="Move to the top left of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorTopLeft}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="CenterHorizontally,Top" ToolTip="Move to the top center of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorTopCenter}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="Right,Top" ToolTip="Move to the top right of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorTopRight}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="Left,CenterVertically" ToolTip="Move to the middle left of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorMiddleLeft}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="CenterHorizontally,CenterVertically" ToolTip="Move to the the center of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorMiddleCenter}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="Right,CenterVertically" ToolTip="Move to the middle right of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorMiddleRight}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="Left,Bottom" ToolTip="Move to the bottom left of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorBottomLeft}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="CenterHorizontally,Bottom" ToolTip="Move to the bottom center of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorBottomCenter}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignBothCommand}" CommandParameter="Right,Bottom" ToolTip="Move to the bottom right of the canvas" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AnchorBottomRight}" /></Viewbox>
                                        </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel Margin="18,0,0,0">
                                        <TextBlock Text="Horizontal" Style="{StaticResource Label}" Width="Auto" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding AlignCommand}" CommandParameter="Left" ToolTip="Align to the left edge" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AlignLeft}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignCommand}" CommandParameter="CenterHorizontally" ToolTip="Center horizontally" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AlignCenter}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignCommand}" CommandParameter="Right" ToolTip="Align to the right edge" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AlignRight}" /></Viewbox>
                                        </Button>
                                        </StackPanel>
                                        <TextBlock Text="Vertical" Style="{StaticResource Label}" Width="Auto" Margin="0,8,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding AlignCommand}" CommandParameter="Top" ToolTip="Align to the top edge" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AlignTop}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignCommand}" CommandParameter="CenterVertically" ToolTip="Center vertically" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AlignMiddle}" /></Viewbox>
                                        </Button>
                                        <Button Command="{Binding AlignCommand}" CommandParameter="Bottom" ToolTip="Align to the bottom edge" Padding="0" Margin="0,0,3,3" Width="34" Height="28" >
                                            <Viewbox Width="16" Height="16"><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.AlignBottom}" /></Viewbox>
                                        </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Shape -->
                        <Expander Header="Shape" IsExpanded="True" Visibility="{Binding IsShape, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- The kind of shape is chosen when it is drawn (Shapes tool); here it is only shown -->
                                <StackPanel Style="{StaticResource Row}" Margin="0,0,0,6">
                                    <TextBlock Text="Type" Style="{StaticResource Label}" />
                                    <Border Background="#FF202020" BorderBrush="#FF353535" BorderThickness="1" CornerRadius="4" Padding="8,3" MinWidth="120">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ShapeKind, Converter={StaticResource ShapeName}}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                            <TextBlock Text=" (custom outline)" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                                       Visibility="{Binding HasCustomOutline, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding CanFill, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox Content="Fill" IsChecked="{Binding FillEnabled}" Width="72" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding FillBrush}" Command="{Binding PickFillCommand}" ToolTip="Fill color"
                                            Visibility="{Binding HasGradient, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <CheckBox Content="{Binding IsLine, Converter={StaticResource LineOrBorder}}" IsChecked="{Binding StrokeEnabled}" Width="72" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsLine, Converter={StaticResource InverseBool}}" />
                                    <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding StrokeBrush}" Command="{Binding PickStrokeCommand}" ToolTip="Border / line color" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Width" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="0" Maximum="200" Value="{Binding StrokeWidth}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Line style" Style="{StaticResource Label}" />
                                    <ComboBox Width="110" ItemsSource="{Binding Source={x:Static vm:ObjectPropertiesViewModel.StrokeStyleNames}}" SelectedIndex="{Binding StrokeStyleIndex}"
                                              ToolTip="Solid, dashed or dotted border / line" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding IsDashed, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Dash" Style="{StaticResource Label}" ToolTip="Length of each dash" />
                                    <ctl:NumberSlider Minimum="1" Maximum="200" Value="{Binding DashLengthPx}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasDash, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Gap" Style="{StaticResource Label}" ToolTip="Space between the dashes or dots" />
                                    <ctl:NumberSlider Minimum="1" Maximum="200" Value="{Binding DashGapPx}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding IsLine, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox Content="Arrow at start" IsChecked="{Binding ArrowStart}" Margin="0,0,12,0" />
                                    <CheckBox Content="Arrow at end" IsChecked="{Binding ArrowEnd}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasCorners, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Corners" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="0" Maximum="500" Value="{Binding CornerRadius}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasInner, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding InnerLabel}" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="0" Maximum="95" Value="{Binding InnerPercent}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasSweep, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Angle" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="10" Maximum="360" Value="{Binding Sweep}" SliderWidth="96" BoxWidth="52" Unit="°" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasPoints, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Points" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="3" Maximum="24" Value="{Binding Points}" SliderWidth="96" BoxWidth="52" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Text designs: ready-made looks, one click -->
                        <Expander Header="Text designs" IsExpanded="True" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding TextPresetItems}" Margin="0,0,0,2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="60" MinHeight="0" Margin="0,0,5,5" Padding="2" ToolTip="{Binding Description}"
                                                        Command="{Binding DataContext.ApplyTextPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Preset}">
                                                    <StackPanel>
                                                        <Border CornerRadius="3" ClipToBounds="True" HorizontalAlignment="Center">
                                                            <Image Source="{Binding Preview}" Width="52" Height="52" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                        </Expander>

                        <!-- Text -->
                        <Expander Header="Text" IsExpanded="True" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBox IsEnabled="{Binding IsSingle}" Text="{Binding TextContent, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12"
                                         MinHeight="44" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                                         HorizontalContentAlignment="Left" ToolTip="Type, then click elsewhere to apply" />
                                <ItemsControl ItemsSource="{Binding BrandFonts}" Visibility="{Binding HasBrandFonts, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" FontFamily="{Binding}" Margin="0,0,4,4" Padding="8,3" ToolTip="Your brand font (Settings > Brand Kit)"
                                                    Command="{Binding DataContext.ApplyFontCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ComboBox ItemsSource="{Binding Source={x:Static opt:TextToolOptions.InstalledFonts}}" SelectedItem="{Binding FontFamily}"
                                          Margin="0,0,0,4">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Source}" FontFamily="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Size" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="4" Maximum="1000" Value="{Binding FontSize}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasGradient, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="Color" Style="{StaticResource Label}" />
                                    <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding TextBrush}" Command="{Binding PickTextColorCommand}" ToolTip="Text color" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <ToggleButton Content="B" FontWeight="Bold" Width="30" Padding="0" IsChecked="{Binding Bold}" ToolTip="Bold" />
                                    <ToggleButton Content="I" FontStyle="Italic" Width="30" Padding="0" Margin="4,0,0,0" IsChecked="{Binding Italic}" ToolTip="Italic" />
                                    <ComboBox ItemsSource="{Binding Alignments}" SelectedItem="{Binding Align}" Width="96" Margin="8,0,0,0" ToolTip="Alignment of the lines" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Letter gap" Style="{StaticResource Label}" ToolTip="Space between the letters (100 % = the size of the text; negative = tighter)" />
                                    <ctl:NumberSlider Minimum="-30" Maximum="200" Value="{Binding LetterSpacingPercent}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Word gap" Style="{StaticResource Label}" ToolTip="Extra space between the words" />
                                    <ctl:NumberSlider Minimum="-50" Maximum="400" Value="{Binding WordSpacingPercent}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Line gap" Style="{StaticResource Label}" ToolTip="Space between the lines of text (100 % = the font's own spacing)" />
                                    <ctl:NumberSlider Minimum="50" Maximum="300" Value="{Binding LineSpacingPercent}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Curve" Style="{StaticResource Label}" ToolTip="Bend the text along a circle: positive like a rainbow, negative like a smile (one line)" />
                                    <ctl:NumberSlider Minimum="-360" Maximum="360" Value="{Binding TextArc}" SliderWidth="96" BoxWidth="52" Unit="°" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <CheckBox Content="Outline" IsChecked="{Binding OutlineEnabled}" Width="72" VerticalAlignment="Center" ToolTip="A line around the letters" />
                                    <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding OutlineBrush}" Command="{Binding PickOutlineColorCommand}" ToolTip="Outline color" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Thickness" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="0" Maximum="60" Value="{Binding OutlineWidth}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Image -->
                        <Expander Header="Image" IsExpanded="True" Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Original size" Command="{Binding OriginalSizeCommand}" HorizontalAlignment="Left" />
                        </Expander>

                        <!-- Reshape: drag the corner points of any object (a square becomes a trapezium, a picture gets a perspective...) -->
                        <!-- Gradient (filled shapes and text): opens by itself when a gradient is applied -->
                        <Expander Header="{Binding GradientTitle}" IsExpanded="{Binding GradientEnabled, Mode=OneWay}" Visibility="{Binding CanGradient, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <CheckBox Content="Use a gradient" IsChecked="{Binding GradientEnabled}" Margin="0,0,0,4"
                                          ToolTip="Fade through two or more colors instead of one flat color" />
                                <StackPanel Visibility="{Binding GradientEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding GradientStops}" Margin="0,2,0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding Brush}" Command="{Binding PickCommand}" ToolTip="Change this color" />
                                                        <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding Percent}" SliderWidth="86" BoxWidth="48" Unit="%" Margin="8,0,0,0"
                                                                          ToolTip="Where this color sits along the gradient" />
                                                        <Button Content="&#x2715;" Command="{Binding RemoveCommand}" Width="24" Padding="0" Margin="6,0,0,0" ToolTip="Remove this color" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="32,3,0,0">
                                                        <TextBlock Text="Opacity" Style="{StaticResource InspectorLabel}" Width="48" />
                                                        <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding OpacityPercent}" SliderWidth="60" BoxWidth="48" Unit="%"
                                                                          ToolTip="How solid this color is (0 = see-through)" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                        <Button Content="+ Add color" Command="{Binding AddGradientStopCommand}" ToolTip="Add one more color to the gradient (up to 8)" />
                                        <Button Content="&#x21C4; Reverse" Command="{Binding SwapGradientCommand}" Margin="6,0,0,0" ToolTip="Run the gradient the other way" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- Minimized while no gradient is applied; opens by itself when one is -->
                                <TextBlock Text="Presets" Style="{StaticResource Label}" Width="Auto" Margin="0,2,0,4" />
                                    <ItemsControl ItemsSource="{Binding GradientPresets}" Margin="0,2,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="{Binding Preview}" ToolTip="{Binding Name}" Width="34" Height="22" MinHeight="0" Padding="0" Margin="0,0,5,5"
                                                        Command="{Binding DataContext.ApplyGradientPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                <StackPanel Visibility="{Binding GradientEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <CheckBox Content="Also on the border" IsChecked="{Binding GradientBorder}" Margin="0,3,0,0"
                                              Visibility="{Binding CanGradientBorder, Converter={StaticResource BoolToVisibility}}" />
                                    <CheckBox Content="Radial (from the middle)" IsChecked="{Binding GradientRadial}" Margin="0,3,0,0" />
                                    <StackPanel Style="{StaticResource Row}" Visibility="{Binding GradientIsLinear, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Angle" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding GradientAngle}" SliderWidth="96" BoxWidth="52" Unit="&#xB0;"
                                                          ToolTip="0 = left to right, 90 = top to bottom" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Adjust: brightness, contrast, color and blur of the object itself, without any dialog -->
                        <Expander IsExpanded="{Binding HasTone, Mode=OneWay}">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="On" FontSize="11" FontWeight="Normal" Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding HasTone, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Adjust" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Brightness" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="-100" Maximum="100" Value="{Binding ToneBrightness}" SliderWidth="96" BoxWidth="52" Unit="" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Contrast" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="-100" Maximum="100" Value="{Binding ToneContrast}" SliderWidth="96" BoxWidth="52" Unit="" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Saturation" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="-100" Maximum="100" Value="{Binding ToneSaturation}" SliderWidth="96" BoxWidth="52" Unit="" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Hue" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding ToneHue}" SliderWidth="96" BoxWidth="52" Unit="°" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Blur" Style="{StaticResource Label}" />
                                    <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding BlurAmount}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                </StackPanel>
                                <Button Content="Reset" Command="{Binding ResetToneCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>

                        <!-- Shadow (shapes, text, images and groups): the checkbox in the bar turns it on -->
                        <Expander IsExpanded="{Binding ShadowEnabled, Mode=OneWay}">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="On" FontSize="11" FontWeight="Normal" Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding ShadowEnabled, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Shadow" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox Content="Add a shadow" IsChecked="{Binding ShadowEnabled}" Margin="0,0,0,4" />
                                <StackPanel Style="{StaticResource Row}" Visibility="{Binding ShadowEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Color" Style="{StaticResource Label}" />
                                    <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding ShadowBrush}" Command="{Binding PickShadowColorCommand}" ToolTip="Shadow color" />
                                </StackPanel>
                                <!-- Quick looks: one click adds the shadow and sets everything -->
                                <TextBlock Text="Presets" Style="{StaticResource Label}" Width="Auto" Margin="0,2,0,4" />
                                    <ItemsControl ItemsSource="{Binding ShadowPresetItems}" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- A picture of the shadow on a sample object, with its name underneath -->
                                                <Button Width="60" MinHeight="0" Margin="0,0,5,5" Padding="2" ToolTip="{Binding Description}"
                                                        Command="{Binding DataContext.ApplyShadowPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Preset}">
                                                    <StackPanel>
                                                        <Border CornerRadius="3" ClipToBounds="True" HorizontalAlignment="Center">
                                                            <Image Source="{Binding Preview}" Width="52" Height="52" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                <StackPanel Visibility="{Binding ShadowEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Opacity" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding ShadowOpacity}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Blur" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding ShadowBlur}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Distance" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="200" Value="{Binding ShadowDistance}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Angle" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding ShadowAngle}" SliderWidth="96" BoxWidth="52" Unit="°" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Size" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="10" Maximum="300" Value="{Binding ShadowSize}" SliderWidth="96" BoxWidth="52" Unit="%"
                                                          ToolTip="How big the shadow is: below 100 % it is smaller than the object, above 100 % bigger" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Glow: a soft light around the object -->
                        <Expander IsExpanded="{Binding GlowEnabled, Mode=OneWay}">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="On" FontSize="11" FontWeight="Normal" Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding GlowEnabled, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Glow" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox Content="Add a glow" IsChecked="{Binding GlowEnabled}" Margin="0,0,0,4" />
                                <StackPanel Visibility="{Binding GlowEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Color" Style="{StaticResource Label}" />
                                        <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding GlowBrush}" Command="{Binding PickGlowColorCommand}" ToolTip="Glow color" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Size" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="1" Maximum="200" Value="{Binding GlowSize}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Strength" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="10" Maximum="400" Value="{Binding GlowIntensity}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Opacity" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding GlowOpacity}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Inner shadow: a shadow inside the edges -->
                        <Expander IsExpanded="{Binding InnerShadowEnabled, Mode=OneWay}">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="On" FontSize="11" FontWeight="Normal" Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding InnerShadowEnabled, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Inner shadow" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox Content="Add an inner shadow" IsChecked="{Binding InnerShadowEnabled}" Margin="0,0,0,4" />
                                <StackPanel Visibility="{Binding InnerShadowEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Color" Style="{StaticResource Label}" />
                                        <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding InnerShadowBrush}" Command="{Binding PickInnerShadowColorCommand}" ToolTip="Inner shadow color" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Opacity" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding InnerShadowOpacity}" SliderWidth="96" BoxWidth="52" Unit="%" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Distance" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="200" Value="{Binding InnerShadowDistance}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Angle" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding InnerShadowAngle}" SliderWidth="96" BoxWidth="52" Unit="°" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Blur" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="200" Value="{Binding InnerShadowBlur}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- Outline: a line around the outside of the object -->
                        <Expander IsExpanded="{Binding ObjectOutlineEnabled, Mode=OneWay}">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="On" FontSize="11" FontWeight="Normal" Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding ObjectOutlineEnabled, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Outline" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox Content="Add an outline around the object" IsChecked="{Binding ObjectOutlineEnabled}" Margin="0,0,0,4" />
                                <StackPanel Visibility="{Binding ObjectOutlineEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Color" Style="{StaticResource Label}" />
                                        <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding ObjectOutlineBrush}" Command="{Binding PickObjectOutlineColorCommand}" ToolTip="Outline color" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Width" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="1" Maximum="100" Value="{Binding ObjectOutlineWidth}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- 3D (shapes, text, images and groups): a solid side behind the object and lit / shaded edges on its face -->
                        <Expander IsExpanded="{Binding ThreeDEnabled, Mode=OneWay}">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="On" FontSize="11" FontWeight="Normal" Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding ThreeDEnabled, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="3D" FontWeight="SemiBold" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox Content="Use a 3D look" IsChecked="{Binding ThreeDEnabled}" Margin="0,0,0,4"
                                          ToolTip="Gives the object a solid side, like a block or a 3D letter" />
                                <ItemsControl ItemsSource="{Binding ThreeDPresets}" Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" ToolTip="{Binding Description}" Margin="0,0,5,5"
                                                    Command="{Binding DataContext.ApplyThreeDPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding ThreeDEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Depth" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="150" Value="{Binding ThreeDDepth}" SliderWidth="96" BoxWidth="52" Unit="px" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Angle" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="-180" Maximum="180" Value="{Binding ThreeDAngle}" SliderWidth="96" BoxWidth="52" Unit="°" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Edges" Style="{StaticResource Label}" />
                                        <ctl:NumberSlider Minimum="0" Maximum="100" Value="{Binding ThreeDBevel}" SliderWidth="96" BoxWidth="52" Unit="%"
                                                          ToolTip="Light on the top-left edge, shade on the bottom-right edge of the face" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Row}">
                                        <CheckBox Content="Auto color" IsChecked="{Binding ThreeDAutoColor}" Width="90" VerticalAlignment="Center"
                                                  ToolTip="On: the side is the object's own color, darker. Off: choose the color of the side." />
                                        <Button Style="{StaticResource ColorSwatchButton}" Margin="0" Background="{Binding ThreeDBrush}" Command="{Binding PickThreeDColorCommand}"
                                                ToolTip="Color of the side" Visibility="{Binding ThreeDAutoColor, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Group -->
                    <Expander Header="Group" IsExpanded="True" Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Ungroup (Ctrl+Shift+G)" Command="{Binding DataContext.Layers.UngroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                HorizontalAlignment="Left" />
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
