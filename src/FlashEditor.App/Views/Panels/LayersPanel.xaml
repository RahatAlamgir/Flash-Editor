<UserControl x:Class="FlashEditor.App.Views.Panels.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FlashEditor.App.Views.Controls">
    <UserControl.Resources>
        <!-- Small checkerboard behind layer thumbnails -->
        <DrawingBrush x:Key="ThumbChecker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFCCCCCC" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FF999999" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Padlock toggle: faint when unlocked, bright when locked -->
        <Style x:Key="LockToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Lock / unlock (Ctrl+L)" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Width="24" Height="24">
                            <Path x:Name="Lock" Width="18" Height="18" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Opacity="0.2" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Lock" Property="Opacity" Value="1" />
                                <Setter TargetName="Lock" Property="Stroke" Value="#FFFFB020" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Lock" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small arrow that opens / closes a group: points down when open, right when closed -->
        <Style x:Key="ExpandToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Show / hide the parts of this group" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Width="20" Height="26">
                            <Path x:Name="Arrow" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Down}"
                                  RenderTransformOrigin="0.5,0.5" Width="16" Height="16" Stretch="Uniform" Opacity="0.8">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eye icon toggle for layer visibility -->
        <Style x:Key="EyeToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Show / hide layer" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Width="24" Height="24">
                            <Path x:Name="Eye" Width="18" Height="18" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Eye}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Eye" Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelTitleBar}">
            <TextBlock Text="LAYERS" Style="{StaticResource PanelTitle}" />
        </Border>

        <!-- Blend mode and opacity of the selected layer, in two compact lines (like Photoshop) -->
        <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Mix" Style="{StaticResource InspectorLabel}" Width="54" ToolTip="Blend mode: how this layer's colors mix with the layers below it" />
            <ComboBox Grid.Column="1" Style="{StaticResource CompactCombo}" ItemsSource="{Binding Document.ActiveLayer.BlendModeNames}"
                      SelectedItem="{Binding Document.ActiveLayer.BlendModeName}"
                      ToolTip="{Binding Document.ActiveLayer.BlendModeHelp}" />
            <TextBlock Grid.Row="1" Text="Opacity" Style="{StaticResource InspectorLabel}" Width="54" Margin="0,6,0,0" />
            <ctl:NumberSlider Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" SliderWidth="120" BoxWidth="48" Unit="%"
                              Value="{Binding Document.ActiveLayer.OpacityPercent}" />
        </Grid>

        <!-- Settings of an adjustment layer -->
        <StackPanel DockPanel.Dock="Top" Margin="10,0,10,6" Visibility="{Binding Document.ActiveLayer.IsAdjustment, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Adjustment: changes the colors of the layers below" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Brightness" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-100" Maximum="100" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.AdjustBrightness}" /></Grid>
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Contrast" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-100" Maximum="100" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.AdjustContrast}" /></Grid>
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Saturation" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-100" Maximum="100" SliderWidth="96" BoxWidth="58" Value="{Binding Document.ActiveLayer.AdjustSaturation}" /></Grid>
            <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Hue" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                <ctl:NumberSlider Grid.Column="1" Minimum="-180" Maximum="180" SliderWidth="96" BoxWidth="58" Unit="&#xB0;" Value="{Binding Document.ActiveLayer.AdjustHue}" /></Grid>
        </StackPanel>

        <!-- Select every layer, and lock / unlock the selected layers -->
        <Grid DockPanel.Dock="Top" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Select all" Style="{StaticResource CompactButton}" Padding="1,2" Margin="0,0,3,0"
                    Command="{Binding Layers.SelectAllLayersCommand}"
                    ToolTip="Select every layer (Ctrl+A with the Select / Move tool)" />
            <Button Grid.Column="1" Content="Lock all" Style="{StaticResource CompactButton}" Padding="1,2" Margin="0,0,3,0"
                    Command="{Binding Layers.LockSelectedCommand}"
                    ToolTip="Lock every selected layer that is not locked. Locked layers cannot be picked on the canvas or changed." />
            <Button Grid.Column="2" Content="Unlock all" Style="{StaticResource CompactButton}" Padding="1,2"
                    Command="{Binding Layers.UnlockSelectedCommand}"
                    ToolTip="Unlock every selected layer that is locked" />
            <Button Grid.Column="3" Content="Merge" Style="{StaticResource CompactButton}" Padding="1,2" Margin="3,0,0,0"
                    Command="{Binding Layers.MergeSelectedCommand}"
                    ToolTip="Quick merge: select two or more layers, then click to merge them into one layer (Ctrl+E). Use Group (Ctrl+G) to keep them editable." />
        </Grid>

        <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource DividerBrush}" />

        <!-- Buttons along the bottom edge -->
        <Border DockPanel.Dock="Bottom" Background="#FF2B2B2B" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="6,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Command="{Binding Layers.NewLayerCommand}" ToolTip="New layer (Ctrl+Shift+N)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding Layers.DuplicateCommand}" ToolTip="Duplicate layer (Ctrl+D)">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Duplicate}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding Layers.MoveUpCommand}" ToolTip="Move layer up">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Up}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding Layers.MoveDownCommand}" ToolTip="Move layer down">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Down}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding Layers.MergeDownCommand}" ToolTip="Merge down (Ctrl+E). With several layers selected: merge all of them into one.">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Merge}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding Layers.DeleteCommand}" ToolTip="Delete layer">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Delete}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Layer list (top layer first) -->
        <Grid>
        <ListBox x:Name="LayerList" Style="{StaticResource PanelList}" SelectionMode="Extended" AllowDrop="True"
                 SelectionChanged="OnLayerSelectionChanged"
                 ToolTip="Drag a layer up or down to change its order. Ctrl+click or Shift+click selects several layers (Ctrl+G groups them)."
                 PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove" PreviewMouseLeftButtonUp="OnListMouseUp"
                 DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop"
                 ItemsSource="{Binding Document.LayersTopDown}" SelectedItem="{Binding Document.ActiveLayer}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource EyeToggle}" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" />
                            <!-- Arrow that opens / closes a group (only shown for groups) -->
                            <CheckBox Grid.Column="1" Style="{StaticResource ExpandToggle}" IsChecked="{Binding IsExpanded}"
                                      Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox Grid.Column="4" Style="{StaticResource LockToggle}" IsChecked="{Binding IsLocked}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Border Grid.Column="2" Width="42" Height="28" Margin="2,0,8,0" Background="{StaticResource ThumbChecker}"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                <Image Source="{Binding Icon}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}" MouseLeftButtonDown="OnNameMouseDown" ToolTip="Double-click to rename" />
                            <TextBox Grid.Column="3" Text="{Binding Name, UpdateSourceTrigger=Explicit}" VerticalAlignment="Center"
                                     Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                                     IsVisibleChanged="OnEditorVisibleChanged" KeyDown="OnEditorKeyDown" LostKeyboardFocus="OnEditorLostFocus" />
                        </Grid>

                        <!-- The parts of a group, indented under it (Canva style). Click one to select the group. -->
                        <ItemsControl ItemsSource="{Binding Children}" Margin="46,0,0,4"
                                      Visibility="{Binding ShowChildren, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32" PreviewMouseLeftButtonDown="OnPartMouseDown">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <!-- Set here (not on the element) so the selected-row trigger below can override it -->
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="26" Margin="0,0,8,0" Background="{StaticResource ThumbChecker}"
                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,6,0" ToolTip="Click to edit this part inside the group. Double-click to rename.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=Explicit}" VerticalAlignment="Center"
                                                 Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                                                 IsVisibleChanged="OnEditorVisibleChanged" KeyDown="OnEditorKeyDown" LostKeyboardFocus="OnEditorLostFocus" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Shows where the dragged layer will land -->
        <Border x:Name="DropLine" Height="3" CornerRadius="1.5" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Margin="4,0,4,0" Background="{StaticResource AccentBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
