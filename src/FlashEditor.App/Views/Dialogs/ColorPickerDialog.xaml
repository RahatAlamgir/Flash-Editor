<Window x:Class="FlashEditor.App.Views.Dialogs.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <DockPanel>
        <!-- Buttons in a bar along the bottom -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource DialogPrimaryButton}" />
            </DockPanel>
        </Border>
        <StackPanel Margin="24,20,24,22">
            <StackPanel Orientation="Horizontal">
                <!-- Saturation (x) / Brightness (y) square -->
                <Grid x:Name="SvArea" Width="256" Height="256" Cursor="Cross" ClipToBounds="True"
                      MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnMouseUp">
                    <Image x:Name="SvImage" Stretch="Fill" />
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" />
                    </Canvas>
                </Grid>

                <!-- Hue strip -->
                <Grid x:Name="HueArea" Width="22" Height="256" Margin="12,0,0,0" Cursor="Hand"
                      MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnMouseUp">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0000" Offset="0" />
                                <GradientStop Color="#FFFF00" Offset="0.1667" />
                                <GradientStop Color="#00FF00" Offset="0.3333" />
                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                <GradientStop Color="#0000FF" Offset="0.6667" />
                                <GradientStop Color="#FF00FF" Offset="0.8333" />
                                <GradientStop Color="#FF0000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="HueMarker" Width="26" Height="4" Canvas.Left="-2" Stroke="White" StrokeThickness="1.5" />
                    </Canvas>
                </Grid>

                <!-- Values -->
                <StackPanel Width="150" Margin="16,0,0,0">
                    <TextBlock Text="New / Current" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Height="56">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Rectangle x:Name="NewSwatch" />
                            <Rectangle x:Name="OldSwatch" Grid.Row="1" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hex" VerticalAlignment="Center" />
                        <TextBox x:Name="HexBox" Grid.Column="1" LostFocus="OnTextCommitted" KeyDown="OnTextKeyDown" />
                        <TextBlock Grid.Row="2" Text="R" VerticalAlignment="Center" />
                        <TextBox x:Name="RedBox" Grid.Row="2" Grid.Column="1" LostFocus="OnTextCommitted" KeyDown="OnTextKeyDown" />
                        <TextBlock Grid.Row="4" Text="G" VerticalAlignment="Center" />
                        <TextBox x:Name="GreenBox" Grid.Row="4" Grid.Column="1" LostFocus="OnTextCommitted" KeyDown="OnTextKeyDown" />
                        <TextBlock Grid.Row="6" Text="B" VerticalAlignment="Center" />
                        <TextBox x:Name="BlueBox" Grid.Row="6" Grid.Column="1" LostFocus="OnTextCommitted" KeyDown="OnTextKeyDown" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Colors picked last, and colors you saved -->
            <TextBlock x:Name="BrandTitle" Text="Brand colors" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,10,0,4" />
            <ItemsControl x:Name="BrandList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="22" Height="22" Margin="0,0,4,4" CornerRadius="3" Cursor="Hand"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                Background="{Binding}" MouseLeftButtonDown="OnSwatchClick" ToolTip="Brand color (Settings > Brand Kit)" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Recent" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,10,0,4" />
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="22" Height="22" Margin="0,0,4,4" CornerRadius="3" Cursor="Hand"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                Background="{Binding}" MouseLeftButtonDown="OnSwatchClick" ToolTip="{Binding Color}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,6,0,4">
                <Button DockPanel.Dock="Right" Content="+ Save this color" Click="OnSaveSwatch" Padding="8,2" MinWidth="0" MinHeight="0" FontSize="11"
                        ToolTip="Keep this color in My swatches" />
                <TextBlock Text="My swatches" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="MineList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="22" Height="22" Margin="0,0,4,4" CornerRadius="3" Cursor="Hand"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                Background="{Binding}" MouseLeftButtonDown="OnSwatchClick" MouseRightButtonDown="OnSwatchRemove"
                                ToolTip="Click to use this color, right-click to remove it" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoSwatchesHint" Text="Click + Save this color to keep colors you like here." FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />

            <!-- Quick swatches -->
            <ItemsControl x:Name="SwatchList" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="22" Height="22" Margin="0,0,4,4" CornerRadius="3" Cursor="Hand"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                Background="{Binding}" MouseLeftButtonDown="OnSwatchClick" ToolTip="{Binding Color}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </DockPanel>
</Window>
