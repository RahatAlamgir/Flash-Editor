<Window x:Class="FlashEditor.App.Views.Dialogs.ImageSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlashEditor.App.Views.Dialogs.Controls"
        Title="Resize Image (Resolution)" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <DockPanel>
        <!-- Buttons in a bar along the bottom -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                <Button DockPanel.Dock="Right" Content="Resize" IsDefault="True" Click="OnOk" Style="{StaticResource DialogPrimaryButton}" />
            </DockPanel>
        </Border>
        <StackPanel Margin="24,20,24,22">
            <TextBlock x:Name="CurrentSizeText" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,14" FontSize="12"
                       Text="Scales the whole picture (all layers). To only make the saved file smaller, use File > Export instead." />

            <controls:SizeEditor x:Name="Editor" />

            <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

        </StackPanel>
    </DockPanel>
</Window>
