<Window x:Class="FlashEditor.App.Views.Dialogs.ExportForDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export For..." Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- Small checkerboard behind see-through parts of the preview -->
        <DrawingBrush x:Key="ThumbChecker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFCCCCCC" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FF999999" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                <Button DockPanel.Dock="Right" Content="Export..." IsDefault="True" Click="OnOk" Style="{StaticResource DialogPrimaryButton}" />
            </DockPanel>
        </Border>

        <Grid Margin="24,20,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Make a picture for" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                <ComboBox x:Name="PresetBox" SelectionChanged="OnChanged" MaxDropDownHeight="380" DisplayMemberPath="Description">
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" Margin="2,6,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                </ComboBox>

                <TextBlock Text="When the shape is different" Margin="0,16,0,6" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                <RadioButton x:Name="FitOption" GroupName="Fit" IsChecked="True" Checked="OnChanged" Content="Show everything (fill the rest with the background)" />
                <RadioButton x:Name="FillOption" GroupName="Fit" Checked="OnChanged" Content="Fill the whole size (the edges are cut off)" Margin="0,4,0,0" />
                <RadioButton x:Name="StretchOption" GroupName="Fit" Checked="OnChanged" Content="Stretch (the shape changes)" Margin="0,4,0,0" />

                <TextBlock Text="Background" Margin="0,16,0,6" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WhiteOption" GroupName="Bg" IsChecked="True" Checked="OnChanged" Content="White" />
                    <RadioButton x:Name="TransparentOption" GroupName="Bg" Checked="OnChanged" Content="See-through (PNG, WebP)" Margin="18,0,0,0" />
                </StackPanel>

                <TextBlock Text="File type" Margin="0,16,0,4" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="FormatBox" Width="230" SelectionChanged="OnChanged" />
                    <TextBlock Text="Quality" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="90" Width="70" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="OnChanged" />
                    <TextBlock x:Name="QualityText" Text="90" Width="30" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <CheckBox x:Name="AllPagesBox" Content="All pages of this project (one file each)" Margin="0,16,0,0" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Preview" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                <Border Background="{StaticResource ThumbChecker}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Width="260" Height="260">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="SizeText" Margin="0,8,0,0" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
