<Window x:Class="FlashEditor.App.Views.Dialogs.SmartArtDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartArt" Width="860" Height="680" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Insert" IsDefault="True" Click="OnInsert" Style="{StaticResource DialogPrimaryButton}" />
                <TextBlock x:Name="Hint" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}" MaxWidth="560" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="22,6,22,10">
            <TextBlock x:Name="WordsTitle" Text="Your words (one per line)" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="Words" AcceptsReturn="True" TextWrapping="Wrap" Height="84" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" />
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="20,16,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Choose a diagram" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Colors" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource SubtleTextBrush}" />
                <ComboBox x:Name="Scheme" Width="130" SelectionChanged="OnSchemeChanged" />
            </StackPanel>
        </Grid>
        <ListBox x:Name="Categories" DockPanel.Dock="Left" Width="170" Margin="14,0,0,0" BorderThickness="0" Background="Transparent" SelectionChanged="OnCategoryChanged" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6,0,8,0">
            <WrapPanel x:Name="Grid" Margin="8,0,8,8" />
        </ScrollViewer>
    </DockPanel>
</Window>
