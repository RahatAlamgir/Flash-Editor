<Window x:Class="FlashEditor.App.Views.Dialogs.ProjectManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flash Editor - Projects" Width="1000" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" PreviewKeyDown="OnWindowKeyDown"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title and the main actions -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open file..." Click="OnOpenFile" Padding="14,7" MinWidth="0" ToolTip="Open a project or a picture from anywhere on this computer" />
                <Button Content="+  New project" Click="OnNewProject" Padding="16,7" MinWidth="0" Margin="10,0,0,0" FontWeight="SemiBold"
                        Background="{StaticResource AccentBrush}" Foreground="White" ToolTip="Create a project with a name, a size and, if you like, a ready-made layout" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Projects" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="Everything you made with Flash Editor" Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Search and folder -->
        <DockPanel Grid.Row="1" Margin="0,16,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Show folder" Click="OnShowFolder" Padding="10,4" MinWidth="0" ToolTip="Open the projects folder in Windows Explorer" />
                <Button Content="Change folder..." Click="OnChangeFolder" Padding="10,4" MinWidth="0" Margin="6,0,0,0" ToolTip="Choose where new projects are created" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Width="260" HorizontalAlignment="Left" TextChanged="OnSearchChanged" ToolTip="Type part of a project's name" />
            <TextBlock x:Name="FolderText" VerticalAlignment="Center" Margin="14,0,14,0" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- The projects -->
        <Grid Grid.Row="2">
            <ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnListDoubleClick" KeyDown="OnListKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,14,14" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="210" ToolTip="{Binding ToolTip}">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="OnMenuOpen" />
                                    <MenuItem Header="Rename..." Click="OnMenuRename" />
                                    <MenuItem Header="Show in folder" Click="OnMenuShow" />
                                    <Separator />
                                    <MenuItem Header="Remove from this list" Click="OnMenuForget" ToolTip="The file stays where it is" />
                                    <MenuItem Header="Delete (to Recycle Bin)..." Click="OnMenuDelete" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Border Height="130" CornerRadius="5" ClipToBounds="True" Background="{StaticResource CanvasAreaBrush}">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                                    <TextBlock Text="No preview" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Shown while the list is empty -->
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="No projects yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="Click New project to start one. Everything you save appears here." Foreground="{StaticResource SubtleTextBrush}"
                           Margin="0,6,0,14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                <Button Content="+  New project" Click="OnNewProject" Padding="18,8" MinWidth="0" HorizontalAlignment="Center" FontWeight="SemiBold"
                        Background="{StaticResource AccentBrush}" Foreground="White" />
            </StackPanel>
            <TextBlock x:Name="LoadingText" Text="Loading your projects..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
        </Grid>

    </Grid>
</Window>
