<Window x:Class="FlashEditor.App.Views.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="260"
                 VerticalScrollBarVisibility="Auto" FontSize="15" />
        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
            <Button DockPanel.Dock="Right" Content="OK" Click="OnOk" Style="{StaticResource DialogButton}" />
        </DockPanel>
    </StackPanel>
</Window>
