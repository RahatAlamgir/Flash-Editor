<Window x:Class="FlashEditor.App.Views.Dialogs.PhotoGridDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FlashEditor.App.Views.Controls"
        Title="Photo Grid" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                <Button DockPanel.Dock="Right" Content="Add frames" IsDefault="True" Click="OnOk" Style="{StaticResource DialogPrimaryButton}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="24,20,24,22">
            <TextBlock Text="Photo grid" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                       Text="Adds empty frames in a collage layout. Then select the frames and use Insert > Fill Frames with Pictures to drop your photos in. Each photo can be moved and resized inside its frame." />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Layout" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="LayoutBox" SelectionChanged="OnChanged" MaxDropDownHeight="300" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Gap" VerticalAlignment="Center" Width="70" />
                        <ctl:NumberSlider x:Name="GapSlider" Minimum="0" Maximum="80" Value="16" SliderWidth="110" BoxWidth="52" Unit="px" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Border" VerticalAlignment="Center" Width="70" />
                        <ctl:NumberSlider x:Name="PaddingSlider" Minimum="0" Maximum="120" Value="24" SliderWidth="110" BoxWidth="52" Unit="px" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Corners" VerticalAlignment="Center" Width="70" />
                        <ctl:NumberSlider x:Name="CornerSlider" Minimum="0" Maximum="200" Value="12" SliderWidth="110" BoxWidth="52" Unit="px" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <Canvas x:Name="Preview" Width="182" Height="140" ClipToBounds="True" />
                </Border>
            </Grid>
        </StackPanel>
    </DockPanel>
</Window>
