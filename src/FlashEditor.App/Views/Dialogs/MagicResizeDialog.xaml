<Window x:Class="FlashEditor.App.Views.Dialogs.MagicResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magic Resize" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                <Button DockPanel.Dock="Right" Content="Resize" IsDefault="True" Click="OnOk" Style="{StaticResource DialogPrimaryButton}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="24,20,24,22">
            <TextBlock Text="Magic Resize" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                       Text="Turns the design into another size and keeps the layout: everything keeps its proportions and moves to the same relative place, text scales with it, and a background that covers the whole picture covers the new one. Ctrl+Z undoes it." />

            <TextBlock x:Name="CurrentText" Margin="0,12,0,0" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />

            <TextBlock Text="New size" Margin="0,14,0,4" Foreground="{StaticResource SubtleTextBrush}" />
            <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged" MaxDropDownHeight="320" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="WidthBox" Width="80" />
                <TextBlock Text="  Height" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="HeightBox" Width="80" />
                <TextBlock Text="  px" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>

            <CheckBox x:Name="AllPagesBox" Content="Resize every page of this project" Margin="0,14,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
