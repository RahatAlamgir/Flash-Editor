<Window x:Class="FlashEditor.App.Views.Dialogs.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FlashEditor.App.Views.Controls"
        Title="Batch Convert" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                <Button DockPanel.Dock="Right" Content="Convert" IsDefault="True" Click="OnOk" Style="{StaticResource DialogPrimaryButton}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="24,20,24,22">
            <TextBlock Text="Convert a whole folder" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                       Text="Turns every picture in a folder into another format and / or a smaller size. The originals are not changed and nothing is overwritten." />

            <TextBlock Text="Pictures from" Margin="0,16,0,4" Foreground="{StaticResource SubtleTextBrush}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseInput" Margin="6,0,0,0" />
                <TextBox x:Name="InputBox" HorizontalContentAlignment="Left" TextChanged="OnInputChanged" />
            </DockPanel>
            <TextBlock x:Name="CountText" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
            <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" Margin="0,6,0,0" Checked="OnInputChanged" Unchecked="OnInputChanged" />

            <TextBlock Text="Save results in" Margin="0,14,0,4" Foreground="{StaticResource SubtleTextBrush}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse..." Click="OnBrowseOutput" Margin="6,0,0,0" />
                <TextBox x:Name="OutputBox" HorizontalContentAlignment="Left" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="Format" VerticalAlignment="Center" Width="100" />
                <ComboBox x:Name="FormatBox" Width="150" SelectionChanged="OnFormatChanged" />
            </StackPanel>
            <StackPanel x:Name="QualityRow" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Quality" VerticalAlignment="Center" Width="100" />
                <ctl:NumberSlider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="90" SliderWidth="170" BoxWidth="56" Unit="%" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Largest size" VerticalAlignment="Center" Width="100" />
                <TextBox x:Name="MaxWidthBox" Width="70" Text="0" ToolTip="Widest picture, in pixels. 0 = no limit" />
                <TextBlock Text="  x  " VerticalAlignment="Center" />
                <TextBox x:Name="MaxHeightBox" Width="70" Text="0" ToolTip="Tallest picture, in pixels. 0 = no limit" />
                <TextBlock Text="  px (0 = keep size)" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
