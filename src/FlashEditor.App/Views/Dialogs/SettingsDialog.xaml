<Window x:Class="FlashEditor.App.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:FlashEditor.App.Views.Controls"
        Title="Settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <!-- Buttons in a bar along the bottom -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Default" Click="OnDefault" Style="{StaticResource DialogButton}" Margin="0" ToolTip="Back to the standard settings" />
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" />
                <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource DialogPrimaryButton}" />
            </DockPanel>
        </Border>

        <StackPanel Margin="24,20,24,22">
            <TextBlock Text="Undo" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                       Text="Every project has one undo history. All its pages share these steps, so Undo takes back the newest change of the project, whichever page it was made in." />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="Undo steps" VerticalAlignment="Center" Width="100" />
                <ctl:NumberSlider x:Name="StepsSlider" Minimum="1" Maximum="60" Value="30" SliderWidth="170" BoxWidth="56"
                                  ToolTip="How many steps Undo can go back in a project (default 30, at most 60)" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                       Text="Default 30, at most 60. Every step keeps a copy of the changed pixels in memory, so more steps need more memory, most of all with very large pictures. Open projects use the new number at once; the oldest steps are forgotten if you lower it." />
        </StackPanel>
    </DockPanel>
</Window>
