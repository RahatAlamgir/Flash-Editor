<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FlashEditor</AssemblyName>
    <RootNamespace>FlashEditor.App</RootNamespace>
    <Product>Flash Editor</Product>
    <Title>Flash Editor</Title>
    <Description>Image editor with editable objects and AI tools</Description>
    <Version>1.0.0</Version>
    <!-- Icon of FlashEditor.exe (Explorer, taskbar, shortcuts, installer). -->
    <ApplicationIcon>Assets\FlashEditor.ico</ApplicationIcon>
    <!-- WPF0001: the built-in Fluent (dark) theme is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Profile-guided tuning makes the first seconds of dragging / resizing about twice as slow (code is first run in a slow
         "measuring" form). Off = full speed from the first frame. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pictures are big arrays. Normally every array over 85 KB goes to the "large object heap", whose cleanup stalls the editor for a
         moment while dragging or resizing. Raising the limit to 32 MB keeps working buffers in the fast ordinary heap. -->
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="33554432" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window / title-bar icon. -->
    <Resource Include="Assets\FlashEditor.ico" />
    <None Remove="Assets\FlashEditor.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlashEditor.Core\FlashEditor.Core.csproj" />
    <ProjectReference Include="..\FlashEditor.AI\FlashEditor.AI.csproj" />
  </ItemGroup>

</Project>
