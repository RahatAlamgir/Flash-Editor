<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flash Editor dark palette. Change these to re-color the whole app. -->
    <Color x:Key="AccentColor">#FF3B82F6</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="CanvasAreaBrush" Color="#FF161616" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#FF363636" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#553B82F6" />
    <!-- Selection outlines on the canvas -->
    <SolidColorBrush x:Key="SelectionTintBrush" Color="#263D8BFF" />
    <SolidColorBrush x:Key="SelectionAccentBrush" Color="#FF4FC3FF" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="IconBrush" Color="#FFD8D8D8" />
</ResourceDictionary>
