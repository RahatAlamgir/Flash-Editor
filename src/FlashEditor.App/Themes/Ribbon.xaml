<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:FlashEditor.App.Services"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">

    <!-- The ribbon at the top (tabs, and under them groups of buttons). Icons come from the Windows icon font. -->


    <!-- The icon palette. IconTheme gives them their colors (or the plain gray when colorful icons are switched off). -->
    <SolidColorBrush x:Key="Icon.Blue" Color="#5B9BFF" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Sky" Color="#38BDF8" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Teal" Color="#2DD4BF" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Green" Color="#4ADE80" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Lime" Color="#A3E635" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Amber" Color="#FBBF24" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Orange" Color="#FB923C" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Red" Color="#F87171" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Pink" Color="#F472B6" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Purple" Color="#A78BFA" po:Freeze="False" />
    <SolidColorBrush x:Key="Icon.Slate" Color="#94A3B8" po:Freeze="False" />

    <FontFamily x:Key="RibbonIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The whole ribbon: tab row on top, the buttons of the chosen tab below. Tag="collapsed" hides the buttons. -->
    <Style x:Key="RibbonTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource WindowBrush}" Padding="74,3,36,0">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <Border x:Name="Body" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,1" Height="62">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="collapsed">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Padding="12,3,12,4" Margin="0,0,2,0" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0">
                        <Grid>
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="-4,0,-4,-4" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="Bd" Property="Margin" Value="0,0,2,-1" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- A group of buttons with its name under it -->
    <Style x:Key="RibbonGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Padding="3,0,3,0" Margin="0,3,0,3" ToolTip="{TemplateBinding Header}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Big button: picture above, name under it -->
    <Style x:Key="RibbonLarge" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="3,2,3,2" MinWidth="46" Width="Auto">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource RibbonIconFont}" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{Binding Path=(svc:RibbonIcon.Brush), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={StaticResource IconBrush}, TargetNullValue={StaticResource IconBrush}}" Margin="0,0,0,2" />
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="74" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonLargeToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="3,2,3,2" MinWidth="46">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource RibbonIconFont}" FontSize="20" HorizontalAlignment="Center"
                                       Foreground="{Binding Path=(svc:RibbonIcon.Brush), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={StaticResource IconBrush}, TargetNullValue={StaticResource IconBrush}}" Margin="0,0,0,2" />
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="74" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small button: picture and name side by side, up to three above each other -->
    <Style x:Key="RibbonSmall" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="5,0,7,0" Height="19">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource RibbonIconFont}" FontSize="13" Width="19" TextAlignment="Left"
                                       Foreground="{Binding Path=(svc:RibbonIcon.Brush), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={StaticResource IconBrush}, TargetNullValue={StaticResource IconBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonSmallToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="3" Padding="5,0,7,0" Height="19">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource RibbonIconFont}" FontSize="13" Width="19" TextAlignment="Left"
                                       Foreground="{Binding Path=(svc:RibbonIcon.Brush), RelativeSource={RelativeSource TemplatedParent}, FallbackValue={StaticResource IconBrush}, TargetNullValue={StaticResource IconBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The File button at the left end of the tab row: opens the drawer -->
    <Style x:Key="RibbonFileButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Padding="10,3,12,4" Background="{StaticResource HoverBrush}" CornerRadius="4,4,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,1,1,0">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The File drawer: a heading for each group and a row for each command -->
    <Style x:Key="DrawerHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="Margin" Value="14,14,0,4" />
    </Style>

    <Style x:Key="DrawerItem" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="10,0,12,0" Height="34">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="12.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
